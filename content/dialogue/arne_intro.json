{
  "id": "dlg.arne_intro",
  "speaker": "Arne",
  "start": "greet",
  "nodes": {
    "greet": {
      "text": [
        "Mind the roots along here, the whole stretch is roots."
      ],
      "choices": [
        {
          "text": "Any work going?",
          "goto": "ask",
          "when": {
            "quest": {
              "id": "quest.arne_berries",
              "is": "none"
            }
          }
        },
        {
          "text": "I have your berries.",
          "goto": "done",
          "when": {
            "quest": {
              "id": "quest.arne_berries",
              "is": "ready"
            }
          },
          "finish": "quest.arne_berries"
        },
        {
          "text": "Still picking.",
          "goto": "wait",
          "when": {
            "quest": {
              "id": "quest.arne_berries",
              "is": "active"
            }
          }
        },
        {
          "text": "Good day."
        }
      ]
